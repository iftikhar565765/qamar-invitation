{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qamar-invitation",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qamar-invitations",
      "database_id": "6a554261-9f15-48c3-89f1-8bb86d972853"
    }
  ]
}
